{
  "openrpc": "1.2.4",
  "info": {
    "title": "Stats",
    "description": "Provides methods to retrieve application-level system information.",
    "version": "1.0.0"
  },
  "methods": [
    {
      "name": "memoryUsage",
      "summary": "Returns information about container memory usage in bytes.",
      "tags": [
        {
          "name": "capabilities",
          "x-uses": [
            "xrn:firebolt:capability:cpp-client-only"
          ]
        }
      ],
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/MemoryUsage"
        }
      },
      "examples": [
        {
          "name": "Default example",
          "params": [],
          "result": {
            "name": "value",
            "description": "The memory usage information",
            "value": {
              "userMemoryUsed": 126418944,
              "userMemoryLimit": 807948288,
              "gpuMemoryUsed": 353974272,
              "gpuMemoryLimit": 922863616
            }
          }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "MemoryUsage": {
        "title": "MemoryUsage",
        "type": "object",
        "description": "Describes current and maximum memory usage of the container.",
        "properties": {
          "userMemoryUsed": {
            "type": "integer",
            "description": "User memory currently used, in bytes.",
            "minimum": 0
          },
          "userMemoryLimit": {
            "type": "integer",
            "description": "Maximum user memory available, in bytes.",
            "minimum": 0
          },
          "gpuMemoryUsed": {
            "type": "integer",
            "description": "GPU memory currently used, in bytes.",
            "minimum": 0
          },
          "gpuMemoryLimit": {
            "type": "integer",
            "description": "Maximum GPU memory available, in bytes.",
            "minimum": 0
          }
        },
        "required": [
          "userMemoryUsed",
          "userMemoryLimit",
          "gpuMemoryUsed",
          "gpuMemoryLimit"
        ]
      }
    }
  }
}